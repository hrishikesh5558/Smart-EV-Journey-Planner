# Smart EV Backend Environment Variables
# Copy this file to .env and fill in the values

# Application & Security
APP_SECRET_KEY=your-secret-key-change-this-in-production-minimum-32-characters
JWT_SECRET_KEY=your-secret-key-change-this-in-production-minimum-32-characters
APP_ENV=development
DEBUG=true

# Database (MongoDB Community Server or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=smart_ev_db

# Frontend Origin & CORS
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Map / Routing Provider (optional)
# Set to a supported provider key when you have an API key
# MAP_PROVIDER=google
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Charging Station Provider (optional)
# OPENCHARGEMAP_API_KEY=your-openchargemap-api-key

# Email (optional - for password reset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=yourpassword
# FROM_EMAIL=noreply@smartev.app
